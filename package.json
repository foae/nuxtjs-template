{
  "name": "nuxtjs-template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "verify": "tsx --env-file-if-exists=.env scripts/verify.ts",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "nuxt build && playwright test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts",
    "docs:sync": "tsx --env-file-if-exists=.env scripts/docs-sync.ts",
    "skills:sync": "tsx --env-file-if-exists=.env scripts/skills-sync.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.119",
    "@iconify-json/simple-icons": "^1.2.91",
    "@nuxt/ui": "^4.10.0",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.0",
    "nuxt-auth-utils": "^0.5.29",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@adonisjs/hash": "^10.1.0",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "happy-dom": "^20.11.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "packageManager": "pnpm@11.13.1"
}
