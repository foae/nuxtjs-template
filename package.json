{
  "name": "nuxtjs-template",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "backlog": "backlog",
    "backlog:board": "backlog board",
    "backlog:browser": "backlog browser --no-open",
    "check": "tsx --env-file-if-exists=.env scripts/check.ts",
    "verify": "tsx --env-file-if-exists=.env scripts/verify.ts",
    "verify:full": "pnpm verify && pnpm build",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "nuxt build && playwright test && pnpm test:auth",
    "test:auth": "tsx tests/auth/run.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db-reset.ts",
    "docs:sync": "tsx --env-file-if-exists=.env scripts/docs-sync.ts",
    "skills:sync": "tsx --env-file-if-exists=.env scripts/skills-sync.ts",
    "release:prepare": "tsx scripts/release.ts prepare",
    "release:publish": "tsx scripts/release.ts publish"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1134.0",
    "@better-auth/core": "1.7.5",
    "@better-auth/sso": "1.7.5",
    "@iconify-json/lucide": "^1.2.133",
    "@iconify-json/simple-icons": "^1.2.96",
    "@nuxt/ui": "^4.11.1",
    "better-auth": "1.7.5",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@vue/test-utils": "^2.5.1",
    "backlog.md": "1.52.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.4.2"
}
