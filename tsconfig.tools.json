{
  // Fifth root project reference, checked by `nuxt typecheck` in build mode
  // and discoverable by language servers. Keep it last: scripts and tests
  // overlap the generated shared/server projects through their imports.
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["node"],
    "strict": true,
    // TypeScript-only, matching the app/server/shared contexts (see
    // nuxt.config.ts `typescript.tsConfig`). Scripts and tests are .ts too.
    "allowJs": false,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tools.tsbuildinfo",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    // Mirrors the alias Nuxt generates, so tests import `#shared/...` with
    // exactly the same specifier the app and server use.
    "paths": {
      "#shared": ["./shared"],
      "#shared/*": ["./shared/*"]
    }
  },
  "include": [
    "drizzle.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    // Pulled in because scripts and tests import the schema and client.
    "server/database/**/*.ts",
    "server/utils/posts.ts",
    "shared/**/*.ts"
  ],
  // Runtime tests belong to Nuxt's generated app context, including auto-imports.
  "exclude": ["tests/nuxt/**"]
}
