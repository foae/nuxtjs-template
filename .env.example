# Copy to `.env` and adjust. `.env` is gitignored.
# Both the app and drizzle-kit read DATABASE_URL, so there is only one name to get right.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Only needed if 5432 is already in use on your machine (see compose.yml).
# POSTGRES_PORT=5433

# Seals the session cookie for nuxt-auth-utils. MUST be at least 32 characters.
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace-me-with-at-least-32-random-characters
