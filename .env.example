# Copy to `.env` and adjust. `.env` is gitignored.
# Both the app and drizzle-kit read DATABASE_URL, so there is only one name to get right.
DATABASE_URL=postgres://app:app@localhost:5432/app

# Only needed if 5432 is already in use on your machine (see compose.yml).
# POSTGRES_PORT=5433

# Postgres pool size, per process. Multiplies across replicas — 10 (the
# default) times N replicas can exceed Postgres's own max_connections.
# DATABASE_POOL_MAX=10

# Better Auth: exact public origin (HTTPS in production) and a random secret.
# Generate the secret with: openssl rand -base64 32
AUTH_BASE_URL=http://localhost:3000
AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Optional: exact literal direct socket peers allowed to supply one client address
# in X-Real-IP. The handler always overwrites x-auth-client-ip; listed proxies
# must replace this header, while every unlisted peer uses its socket address.
# AUTH_TRUSTED_PROXY_IPS=127.0.0.1

# Explicit local capture; messages are private JSON files, never logged.
# Production MUST use ses, with a verified sender in your production-enabled region.
AUTH_MAIL_TRANSPORT=capture
# AUTH_MAIL_CAPTURE_DIR=.private/mail
# AWS_REGION=eu-west-1
# AUTH_EMAIL_FROM=Your App <noreply@example.com>
# AWS credentials use the SDK's default chain: workload role, profile, or environment.
# Never commit AWS credentials. Restrict the role to ses:SendEmail for your identity.
# If SES applies a configuration set selected for this sender or identity-default,
# it MUST disable open/click tracking for authentication links. Monitoring MUST
# detect authentication-mail delivery failures; a successful request is not proof.

# One-click sign-in. Both values are required to enable a provider.
# Callback: https://your-app.example/api/auth/callback/google (or github).
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_GOOGLE_CLIENT_SECRET=
# AUTH_GITHUB_CLIENT_ID=
# AUTH_GITHUB_CLIENT_SECRET=

# Operator-owned JSON provider array; outside the public web root, not committed.
# AUTH_SSO_CONFIG_FILE=/run/secrets/auth-sso.json

# Tests must explicitly target a dedicated disposable database ending in _e2e.
# E2E_DATABASE_URL=postgres://app:app@localhost:5432/app_e2e
